<?xml version="1.0" encoding="UTF-8"?>
<robot name="dual_arm">

  <!-- ============================================================
       PLANNING GROUPS
  ============================================================ -->
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_tcp"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_tool0"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- ============================================================
       GROUP STATES (home positions from real robot)
  ============================================================ -->
  <group_state name="left_home" group="left_arm">
    <joint name="left_elbow_joint"         value="-2.4564"/>
    <joint name="left_shoulder_lift_joint" value="-1.4352"/>
    <joint name="left_shoulder_pan_joint"  value="-0.5842"/>
    <joint name="left_wrist_1_joint"       value="0.5894"/>
    <joint name="left_wrist_2_joint"       value="-4.1043"/>
    <joint name="left_wrist_3_joint"       value="-1.74"/>
  </group_state>
  <group_state name="right_home" group="right_arm">
    <joint name="right_elbow_joint"         value="2.5167"/>
    <joint name="right_shoulder_lift_joint" value="-1.9195"/>
    <joint name="right_shoulder_pan_joint"  value="-2.5287"/>
    <joint name="right_wrist_1_joint"       value="-3.4194"/>
    <joint name="right_wrist_2_joint"       value="-2.0268"/>
    <joint name="right_wrist_3_joint"       value="0.2502"/>
  </group_state>

  <!-- ============================================================
       DISABLE COLLISIONS
       Only links that exist in v2 URDF (ur_description standard links)
       left:  base_link_inertia, shoulder_link, upper_arm_link,
              forearm_link, wrist_1_link, wrist_2_link, wrist_3_link
       right: same with right_ prefix
       + table_link, table_surface, world
  ============================================================ -->

  <!-- Left arm internal -->
  <disable_collisions link1="left_base_link_inertia" link2="left_shoulder_link"   reason="Adjacent"/>
  <disable_collisions link1="left_base_link_inertia" link2="left_upper_arm_link"  reason="Never"/>
  <disable_collisions link1="left_base_link_inertia" link2="left_wrist_1_link"    reason="Never"/>
  <disable_collisions link1="left_shoulder_link"     link2="left_upper_arm_link"  reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_link"     link2="left_wrist_1_link"    reason="Never"/>
  <disable_collisions link1="left_upper_arm_link"    link2="left_forearm_link"    reason="Adjacent"/>
  <disable_collisions link1="left_forearm_link"      link2="left_wrist_1_link"    reason="Adjacent"/>
  <disable_collisions link1="left_wrist_1_link"      link2="left_wrist_2_link"    reason="Adjacent"/>
  <disable_collisions link1="left_wrist_1_link"      link2="left_wrist_3_link"    reason="Never"/>
  <disable_collisions link1="left_wrist_2_link"      link2="left_wrist_3_link"    reason="Adjacent"/>

  <!-- Right arm internal -->
  <disable_collisions link1="right_base_link_inertia" link2="right_shoulder_link"   reason="Adjacent"/>
  <disable_collisions link1="right_base_link_inertia" link2="right_upper_arm_link"  reason="Never"/>
  <disable_collisions link1="right_base_link_inertia" link2="right_wrist_1_link"    reason="Never"/>
  <disable_collisions link1="right_shoulder_link"     link2="right_upper_arm_link"  reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_link"     link2="right_wrist_1_link"    reason="Never"/>
  <disable_collisions link1="right_upper_arm_link"    link2="right_forearm_link"    reason="Adjacent"/>
  <disable_collisions link1="right_forearm_link"      link2="right_wrist_1_link"    reason="Adjacent"/>
  <disable_collisions link1="right_wrist_1_link"      link2="right_wrist_2_link"    reason="Adjacent"/>
  <disable_collisions link1="right_wrist_1_link"      link2="right_wrist_3_link"    reason="Never"/>
  <disable_collisions link1="right_wrist_2_link"      link2="right_wrist_3_link"    reason="Adjacent"/>

  <!-- Left base with table -->
  <disable_collisions link1="left_base_link_inertia" link2="table_link"    reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_link"     link2="table_link"    reason="Never"/>

  <!-- Right base with table -->
  <disable_collisions link1="right_base_link_inertia" link2="table_link"   reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_link"     link2="table_link"   reason="Never"/>

  <!-- Cross-arm: links that can never collide -->
  <disable_collisions link1="left_base_link_inertia"  link2="right_base_link_inertia"  reason="Never"/>
  <disable_collisions link1="left_base_link_inertia"  link2="right_shoulder_link"      reason="Never"/>
  <disable_collisions link1="left_base_link_inertia"  link2="right_upper_arm_link"     reason="Never"/>


