<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robotiq_2f140" params="prefix parent yaw:=0">

    <link name="${prefix}robotiq_base_link"/>
    <joint name="${prefix}robotiq_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}robotiq_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
    </joint>

    <link name="${prefix}robotiq_140_base_link">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_base_link.stl"/></geometry>
        <material name="${prefix}DarkGrey"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_base_link.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}robotiq_140_base_joint" type="fixed">
      <parent link="${prefix}robotiq_base_link"/>
      <child  link="${prefix}robotiq_140_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}left_outer_knuckle">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_outer_knuckle.stl"/></geometry>
        <material name="${prefix}White"><color rgba="0.9 0.9 0.9 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_outer_knuckle.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}finger_joint" type="revolute">
      <parent link="${prefix}robotiq_140_base_link"/>
      <child  link="${prefix}left_outer_knuckle"/>
      <origin xyz="0 -0.030601 0.054905" rpy="${pi/2 + 0.725} 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0" upper="0.7" effort="1000" velocity="2.0"/>
    </joint>

    <link name="${prefix}left_outer_finger">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_outer_finger.stl"/></geometry>
        <material name="${prefix}DarkGrey2"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_outer_finger.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}left_outer_finger_joint" type="fixed">
      <parent link="${prefix}left_outer_knuckle"/>
      <child  link="${prefix}left_outer_finger"/>
      <origin xyz="0 0.01821998610742 0.0260018192872234" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}left_inner_finger">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_inner_finger.stl"/></geometry>
        <material name="${prefix}DarkGrey3"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_inner_finger.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}left_inner_finger_joint" type="revolute">
      <parent link="${prefix}left_outer_finger"/>
      <child  link="${prefix}left_inner_finger"/>
      <origin xyz="0 0.0817554015893473 -0.0282203446692936" rpy="-0.725 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.8757" upper="0.8757" effort="1000" velocity="2.0"/>
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0"/>
    </joint>

    <link name="${prefix}left_inner_knuckle">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_inner_knuckle.stl"/></geometry>
        <material name="${prefix}DarkGrey4"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_inner_knuckle.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}left_inner_knuckle_joint" type="revolute">
      <parent link="${prefix}robotiq_140_base_link"/>
      <child  link="${prefix}left_inner_knuckle"/>
      <origin xyz="0 -0.0127 0.06142" rpy="${pi/2 + 0.725} 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.8757" upper="0.8757" effort="1000" velocity="2.0"/>
      <mimic joint="${prefix}finger_joint" multiplier="-1" offset="0"/>
    </joint>

    <link name="${prefix}right_outer_knuckle">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_outer_knuckle.stl"/></geometry>
        <material name="${prefix}White2"><color rgba="0.9 0.9 0.9 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_outer_knuckle.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}right_outer_knuckle_joint" type="revolute">
      <parent link="${prefix}robotiq_140_base_link"/>
      <child  link="${prefix}right_outer_knuckle"/>
      <origin xyz="0 0.030601 0.054905" rpy="${pi/2 + 0.725} 0 ${pi}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.725" upper="0.725" effort="1000" velocity="2.0"/>
      <mimic joint="${prefix}finger_joint" multiplier="-1" offset="0"/>
    </joint>

    <link name="${prefix}right_outer_finger">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_outer_finger.stl"/></geometry>
        <material name="${prefix}DarkGrey5"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_outer_finger.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}right_outer_finger_joint" type="fixed">
      <parent link="${prefix}right_outer_knuckle"/>
      <child  link="${prefix}right_outer_finger"/>
      <origin xyz="0 0.01821998610742 0.0260018192872234" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}right_inner_finger">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_inner_finger.stl"/></geometry>
        <material name="${prefix}DarkGrey6"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_inner_finger.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}right_inner_finger_joint" type="revolute">
      <parent link="${prefix}right_outer_finger"/>
      <child  link="${prefix}right_inner_finger"/>
      <origin xyz="0 0.0817554015893473 -0.0282203446692936" rpy="-0.725 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.8757" upper="0.8757" effort="1000" velocity="2.0"/>
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0"/>
    </joint>

    <link name="${prefix}right_inner_knuckle">
      <visual>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/visual/2f_140/robotiq_2f_140_inner_knuckle.stl"/></geometry>
        <material name="${prefix}DarkGrey7"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://dual_arm_pkg/meshes/collision/2f_140/robotiq_2f_140_inner_knuckle.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}right_inner_knuckle_joint" type="revolute">
      <parent link="${prefix}robotiq_140_base_link"/>
      <child  link="${prefix}right_inner_knuckle"/>
      <origin xyz="0 0.0127 0.06142" rpy="${pi/2 + 0.725} 0 ${pi}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.8757" upper="0.8757" effort="1000" velocity="2.0"/>
      <mimic joint="${prefix}finger_joint" multiplier="-1" offset="0"/>
    </joint>

  </xacro:macro>
</robot>
