<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aruco_moveit_planner</name>
  <version>0.1.0</version>
  <description>
    Plan-only MoveIt 2 trajectory for the left UR10e arm guided by an ArUco
    marker detected by the static ZED Mini camera (eye-on-base configuration).
    Visualises the planned trajectory in RViz without executing on real hardware.
  </description>
  <maintainer email="start27.11.25@gmail.com">rosi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>action_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
